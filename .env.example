# Copy to .env and adjust. NEVER commit .env (§38).

# --- Database ---
POSTGRES_DB=zipam
POSTGRES_USER=zipam
POSTGRES_PASSWORD=change-me-in-real-env
# Inside docker-compose the host is "db"; for host-side dev use localhost:5433
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Host port the db container is published on (avoids clashing with a local PG)
ZIPAM_PG_HOST_PORT=5433

# --- Django ---
DJANGO_SECRET_KEY=change-me-at-least-50-random-chars
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend
ZIPAM_LOG_LEVEL=INFO

# --- Web ---
# Frontend (nginx) published port on the host
ZIPAM_WEB_PORT=8080
